# Settings read by scripts/ and by the CARTA GO study. Copy to .env and fill in; .env is git-ignored.

# OSRM server for scripts/build_osrm_network.py (any osrm-backend with a map covering the study area, for example
# the Docker image with a Geofabrik Tennessee extract: https://github.com/Project-OSRM/osrm-backend)
OSRM_URL=http://localhost:5000

# Gurobi license file (academic licenses: https://www.gurobi.com/academia/). Pass it to FleetPy with
# uv run --env-file .env. GUROBI_LICENSE_EXPIRES is shown by scripts/gurobi_license.py for WLS licenses.
GRB_LICENSE_FILE=/absolute/path/to/gurobi.lic
GUROBI_LICENSE_EXPIRES=YYYY-MM-DD

# CARTA GO ride request export (holds rider ids and addresses: keep it outside any repository)
CARTA_GO_REQUESTS="/path/to/CARTA GO Ride Requests.csv"
